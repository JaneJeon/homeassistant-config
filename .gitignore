# Secrets. Never commit these.
secrets.yaml
esphome/secrets.yaml
# Zigbee2MQTT's config holds the Zigbee network key (only present on older installs).
zigbee2mqtt/
# ESPHome device configs often hold inline API keys and Wi-Fi passwords. Out of scope for now.
esphome/
.ssh/
SERVICE_ACCOUNT.json

# Home Assistant's own internal state. HA manages it; HA backups cover it.
.storage/
.cloud/
.ha_run.lock
ip_bans.yaml
deps/
tts/
backups/
*.db
*.db-shm
*.db-wal
*.log
*.log.*

# Installed and updated by HACS, not by us.
custom_components/
www/community/

# Local clutter.
.DS_Store
.vscode/

# Brand icon cache HA downloads.
.cache/

# Node tooling for linting and hooks.
node_modules/

# Written by HA on every upgrade. CI uses .ha-version instead (Renovate bumps it).
.HA_VERSION
