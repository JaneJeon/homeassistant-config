#!/bin/sh
# Secret guard, local layer. Enable once per clone:
#   git config core.hooksPath .githooks
# Needs gitleaks (brew install gitleaks) and python3.
set -e
cd "$(git rev-parse --show-toplevel)"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Refusing to commit." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner .
python3 tools/check-inline-secrets.py --staged
